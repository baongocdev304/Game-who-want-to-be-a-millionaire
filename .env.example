# ============================================================
# CẤU HÌNH BIẾN MÔI TRƯỜNG CHO DỰ ÁN AI LÀ TRIỆU PHÚ (DOCKER)
# ============================================================

# 1. AI API Key (Google Gemini)
GEMINI_API_KEY=your_gemini_api_key_here

# 2. Database PostgreSQL (Dùng cho Docker Compose)
DB_HOST=db
DB_PORT=5432
DB_NAME=millionaire
DB_USER=postgres
DB_PASSWORD=123456

# 3. Cấu hình gửi email OTP (SMTP Gmail)
MAIL_SERVER=smtp.gmail.com
MAIL_PORT=587
MAIL_USERNAME=your_email@gmail.com
MAIL_PASSWORD=your_gmail_app_password

# 4. Cấu hình SePay Webhook Thanh Toán
SEPAY_BANK_CODE=VPBANK
SEPAY_ACCOUNT_NO=0339422186
SEPAY_ACCOUNT_NAME=NGUYEN BAO NGOC
WEBHOOK_SECRET=your_webhook_secret_key

# 5. Ngrok Webhook Tunnel
NGROK_AUTHTOKEN=your_ngrok_authtoken
NGROK_URL=your_ngrok_public_url
